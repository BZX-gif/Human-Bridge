# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Required in production.
# Never commit a real credential. If one was ever exposed, ROTATE it.
DATABASE_URL=postgresql://user:password@host:5432/human_bridge

# Optional. "postgres" (default when DATABASE_URL is set) or "pglite".
# pglite runs an embedded database — useful for local dev and CI with no server.
# HB_DB_DRIVER=pglite
# HB_PGLITE_DIR=.pglite
# HB_DB_POOL_MAX=10

# ─── AI evaluation (OPTIONAL) ────────────────────────────────────────────────
# Human Bridge runs fully without these. When absent, rubric sections are scored
# by conservative deterministic checks and the UI states plainly that AI
# evaluation is unavailable. No AI result is ever fabricated.
#
# Choose ONE provider.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint

# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-20250514

# ─── Seeding ─────────────────────────────────────────────────────────────────
# Required to call POST /api/seed in production (or sign in as an admin).
# SEED_SECRET=
